{
  "name": "Cloud-Chrome",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "runArgs": [
    "--shm-size=1g",
    "--security-opt",
    "seccomp=/tmp/cloudchrome-seccomp.json"
  ],
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "cloud-chrome",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "containerEnv": {
    "CLOUDCHROME_PERSIST_DIR": "${containerWorkspaceFolder}/.cloudchrome",
    "CLOUDCHROME_RUNTIME_DIR": "${containerWorkspaceFolder}/.cloudchrome/run"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "initializeCommand": "cp \"${localWorkspaceFolder}/.devcontainer/seccomp/chrome.json\" /tmp/cloudchrome-seccomp.json && chmod 0644 /tmp/cloudchrome-seccomp.json",
  "postCreateCommand": "cloudchrome init",
  "postStartCommand": "cloudchrome start --if-needed"
}
