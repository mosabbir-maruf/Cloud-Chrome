{
  "name": "Cloud-Chrome",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "runArgs": [
    "--shm-size=1g"
  ],
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "cloud-chrome",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
