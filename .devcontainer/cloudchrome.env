# Cloud-Chrome — centralised, NON-SECRET configuration.
#
# Installed to /etc/cloudchrome/cloudchrome.env (root-owned, 0644).
# Precedence: CLI flag > environment variable > this file > built-in default.
# This file must never contain a secret, password, passphrase or token.
#
# This file defines the configuration surface; the runtime that consumes it
# is Phase 2. Values here are the accepted Revision 5 defaults.

# --- Display ---------------------------------------------------------------
CLOUDCHROME_DISPLAY=:99
CLOUDCHROME_GEOMETRY=1440x900
CLOUDCHROME_DEPTH=24

# --- Network ---------------------------------------------------------------
# 6080 is the ONLY forwarded port (noVNC over WebSocket).
# 5900 (RFB) and 9222 (Chrome DevTools Protocol) stay bound to loopback and
# are never forwarded.
CLOUDCHROME_HTTP_PORT=6080
CLOUDCHROME_VNC_PORT=5900
# Unset by default: the Chrome DevTools Protocol is a full browser control
# surface and is only enabled in an explicit test/debug configuration.
# CLOUDCHROME_CDP_PORT=9222

# --- Desktop ---------------------------------------------------------------
CLOUDCHROME_DESKTOP=xfce

# --- Lifecycle -------------------------------------------------------------
CLOUDCHROME_STOP_TIMEOUT=20

# --- Logging ---------------------------------------------------------------
CLOUDCHROME_LOG_MAX_BYTES=5242880
CLOUDCHROME_LOG_KEEP=3

# --- Paths -----------------------------------------------------------------
CLOUDCHROME_PERSIST_DIR=/workspaces/Cloud-Chrome/.cloudchrome
CLOUDCHROME_RUNTIME_DIR=/run/cloudchrome
