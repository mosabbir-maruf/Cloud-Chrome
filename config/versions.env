# Cloud-Chrome — pinned versions, tracked versions and checksums.
#
# SINGLE SOURCE OF TRUTH. Consumed by:
#   * .devcontainer/Dockerfile  (sourced during build)
#   * .github/workflows/ci.yml  (asserts the built image matches these values)
#   * tests/probe/render-seccomp-profile.sh (rebuilds and verifies the profile)
#
# TWO CATEGORIES, deliberately different:
#
#   PINNED_*   Exact version required at install time. apt fails the build
#              rather than substituting another version. Used for the components
#              Cloud-Chrome drives directly and whose behaviour matters.
#   TRACKED_*  Installed from the signed Ubuntu archive without an exact
#              requirement, so archive security updates are picked up. CI
#              records the installed version and fails only when it is OLDER
#              than the version recorded here.
#
# Downloaded artefacts additionally carry an explicit SHA-256 that is verified
# before anything is unpacked.

# --- Base image -------------------------------------------------------------
BASE_IMAGE_REPOSITORY=mcr.microsoft.com/devcontainers/base
BASE_IMAGE_TAG=ubuntu-24.04
BASE_IMAGE_DIGEST=sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae

# --- Pinned dependencies (exact apt version requirement) ---------------------
PINNED_TIGERVNC_VERSION=1.13.1+dfsg-2build2
PINNED_WEBSOCKIFY_VERSION=0.10.0+dfsg1-5build2
PINNED_JQ_VERSION=1.7.1-3ubuntu0.24.04.2

# --- Tracked dependencies (follow the signed Ubuntu archive) ------------------
TRACKED_XFCE4_VERSION=4.18
TRACKED_XFCE4_TERMINAL_VERSION=1.1.3-1build1
TRACKED_DBUS_X11_VERSION=1.14.10-4ubuntu4.1
TRACKED_GNOME_KEYRING_VERSION=46.1-2ubuntu0.2
TRACKED_LIBSECRET_VERSION=0.21.4-1build3
TRACKED_LIBSECRET_TOOLS_VERSION=0.21.4-1build3
TRACKED_XDOTOOL_VERSION=1:3.20160805.1-5build1
TRACKED_FONTS_LIBERATION2_VERSION=1:2.1.5-3
TRACKED_FONTS_NOTO_COLOR_EMOJI_VERSION=2.047-0ubuntu0.24.04.1

# --- Downloaded artefacts (SHA-256 verified before unpacking) ----------------
CHROME_VERSION=157.0.8103.50-1
CHROME_DEB_URL=https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_157.0.8103.50-1_amd64.deb
CHROME_DEB_SHA256=92148bd14dc05823a64061c2fafcf20d4d82b3fc56f5831206f16d2ac9ee3f79

NOVNC_VERSION=1.7.0
NOVNC_URL=https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz
NOVNC_SHA256=b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6

AGE_VERSION=1.3.2
AGE_URL=https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10

# --- Container seccomp profile -----------------------------------------------
# Baseline: the maintained Docker/Moby default profile, pinned by commit.
#   github.com/moby/profiles @ 7b5ccfab2d6b4e0aa64c6cce401a2705788eafeb
#     ("seccomp: restrict socketpair to AF_UNIX and AF_TIPC", 2026-11-02)
# That baseline uses a socket-domain allow-list, so AF_ALG (38) and AF_VSOCK
# (40) are denied, and it restricts socketpair(2) to AF_UNIX/AF_TIPC.
# .devcontainer/seccomp/chrome.json is that baseline plus two declared namespace
# rules; tests/probe/render-seccomp-profile.sh regenerates it and CI verifies
# that no upstream restriction was dropped.
SECCOMP_BASE_REPOSITORY=github.com/moby/profiles
SECCOMP_BASE_COMMIT=7b5ccfab2d6b4e0aa64c6cce401a2705788eafeb
SECCOMP_BASE_URL=https://raw.githubusercontent.com/moby/profiles/7b5ccfab2d6b4e0aa64c6cce401a2705788eafeb/seccomp/default.json
SECCOMP_BASE_SHA256=15434cc9c9037d85b35027a60721bf45f381782b4283b01d94663366e71569f8
