# Cloud-Chrome — pinned dependency versions and SHA-256 checksums.
#
# SINGLE SOURCE OF TRUTH. Consumed by:
#   * .devcontainer/Dockerfile  (sourced during build; installs exact versions)
#   * .github/workflows/ci.yml  (asserts the built image matches these values)
#
# Rules:
#   * Directly downloaded artefacts carry an explicit SHA-256 that is verified
#     at build time ("sha256sum -c"). GitHub release tarballs have no upstream
#     checksum, so the value recorded here is the trust-on-first-use value and
#     is enforced on every subsequent build.
#   * Ubuntu archive packages are installed with an exact version requirement.
#     apt refuses to substitute a different version, so an unavailable pin is a
#     build failure and never a silent downgrade.
#   * The base image is pinned by immutable OCI digest.

# --- Base image -------------------------------------------------------------
BASE_IMAGE_REPOSITORY=mcr.microsoft.com/devcontainers/base
BASE_IMAGE_TAG=ubuntu-24.04
BASE_IMAGE_DIGEST=sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae

# --- Google Chrome Stable (downloaded artefact, checksum verified) ----------
CHROME_VERSION=157.0.8103.50-1
CHROME_DEB_URL=https://dl.google.com/linux/chrome/deb/pool/main/g/google-chrome-stable/google-chrome-stable_157.0.8103.50-1_amd64.deb
CHROME_DEB_SHA256=92148bd14dc05823a64061c2fafcf20d4d82b3fc56f5831206f16d2ac9ee3f79

# --- noVNC (downloaded artefact, checksum verified) --------------------------
NOVNC_VERSION=1.7.0
NOVNC_URL=https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz
NOVNC_SHA256=b1003a11b6e6e8d8f7f5e5586daae7f8ca651d8aee0aa155ff9ac841c48f52c6

# --- age (downloaded artefact, checksum verified) ----------------------------
AGE_VERSION=1.3.2
AGE_URL=https://github.com/FiloSottile/age/releases/download/v1.3.2/age-v1.3.2-linux-amd64.tar.gz
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10

# --- Ubuntu archive packages: exact version pins (apt refuses substitution) -
TIGERVNC_VERSION=1.13.1+dfsg-2build2
WEBSOCKIFY_VERSION=0.10.0+dfsg1-5build2
JQ_VERSION=1.7.1-3ubuntu0.24.04.2

# --- Container seccomp profile ------------------------------------------------
# .devcontainer/seccomp/chrome.json is Docker's default profile with ONE
# additive rule that permits namespace creation (clone/unshare/setns), which
# Chromium's user-namespace sandbox requires. Measured necessary in a real
# Codespace (failure class S: container seccomp) and applied with
# --security-opt seccomp=<workspace>/.devcontainer/seccomp/chrome.json.
# The base profile below is the upstream source the committed file derives from.
SECCOMP_BASE_VERSION=v28.0.0
SECCOMP_BASE_URL=https://raw.githubusercontent.com/moby/moby/v28.0.0/profiles/seccomp/default.json
SECCOMP_BASE_SHA256=9c1025c88ccaa517b648da571961838744ea2137f176bfe6a48b21294cae9c76

# --- Ubuntu archive packages: recorded versions (reported and asserted by CI) -
XFCE4_VERSION=4.18
XFCE4_TERMINAL_VERSION=1.1.3-1build1
DBUS_X11_VERSION=1.14.10-4ubuntu4.1
GNOME_KEYRING_VERSION=46.1-2ubuntu0.2
LIBSECRET_VERSION=0.21.4-1build3
LIBSECRET_TOOLS_VERSION=0.21.4-1build3
XDOTOOL_VERSION=1:3.20160805.1-5build1
FONTS_LIBERATION2_VERSION=1:2.1.5-3
FONTS_NOTO_COLOR_EMOJI_VERSION=2.047-0ubuntu0.24.04.1
